    {
      "id": "Makefile",
      "label": "Build & Dev Commands",
      "type": "config",
      "file_path": "Makefile",
      "language": "makefile",
      "description": "Development workflow automation with targets for initialization, voice/chat/telegram modes, testing, authentication, and memory management. Includes zombie process cleanup and HF_TOKEN loading from .env.",
      "metadata": {
        "targets": [
          "init - setup venv and dependencies",
          "ensure-venv - create venv if missing",
          "kill-zombies - cleanup stopped jarvis voice processes",
          "voice - run voice loop with HF_TOKEN validation",
          "chat - text REPL mode",
          "ask - one-shot query",
          "telegram - Telegram bridge only",
          "watch - file watching with notifications",
          "notify - send Telegram notification",
          "auth-google - Google OAuth setup",
          "test - run pytest suite",
          "memory-show - display mem0 status",
          "memory-reset - clear mem0 store"
        ],
        "critical_features": [
          "kill-zombies: Prevents macOS mic device lock from stopped processes",
          "load_hf_token: Extracts HF_TOKEN from .env without sourcing (handles spaces)",
          "ensure-venv: Safe dependency check without clobbering .env"
        ],
        "dependencies_installed": "pip install -e '.[dev,wake]'",
        "test_exclusions": [
          "test_memory.py",
          "test_tools_safety.py",
          "test_streaming_pipeline.py",
          "test_agent_streaming.py"
        ]
      }
    },
    {
      "id": "README.md",
      "label": "Project Documentation",
      "type": "documentation",
      "file_path": "README.md",
      "language": "markdown",
      "description": "Main project documentation covering architecture, installation, usage, voice setup, Telegram integration, wake word configuration, streaming, memory management, and safety defaults. Describes Jarvis as a voice-first local coding assistant inspired by Hermes agent gateway pattern.",
      "metadata": {
        "architecture_components": [
          "LLM: Claude API via claude CLI (OAuth, no API key)",
          "Wake word: openWakeWord (hey_jarvis model)",
          "STT: Mistral Voxtral-Mini-4B-Realtime (<500ms latency)",
          "TTS: Sesame CSM 1B (preferred) or Kokoro ONNX (fallback)",
          "Messaging: python-telegram-bot",
          "Watch: watchfiles for Telegram notifications"
        ],
        "commands": [
          "make voice - hands-free voice loop",
          "make chat - streaming text REPL",
          "make ask - one-shot query",
          "make telegram - Telegram bridge only",
          "make watch - watch paths and notify",
          "make notify - send push notification",
          "make test - run test suite"
        ],
        "voice_setup_requirements": {
          "stt": "HuggingFace token with Voxtral access, ~8GB download",
          "tts": "Same HF_TOKEN for CSM, or kokoro fallback",
          "hardware": "M1/M2/M3 16GB+ (recommended), RTX 3060 12GB+ (CUDA), or CPU (slow)"
        },
        "telegram_setup": [
          "Create bot with @BotFather",
          "Get chat ID with /whoami",
          "Set JARVIS_TELEGRAM_TOKEN, JARVIS_TELEGRAM_ALLOWED_CHATS, JARVIS_TELEGRAM_NOTIFY_CHAT"
        ],
        "memory_system": {
          "storage": "SQLite (./.jarvis/memory.db)",
          "tiers": [
            "Episodic log (raw records)",
            "Distilled profile (LLM-generated bullet list, ≤1KB)"
          ],
          "commands": [
            "make memory-show",
            "make memory-refresh",
            "make memory-reset",
            "jarvis memory export"
          ]
        },
        "safety_defaults": {
          "always_on": ["read_file", "list_dir", "grep"],
          "gated": ["write_file (JARVIS_ALLOW_WRITES)", "run_shell (JARVIS_ALLOW_SHELL)"]
        },
        "project_layout": {
          "core_files": [
            "agent.py - multi-turn tool loop",
            "audio.py - VAD recording and playback",
            "config.py - pydantic settings",
            "llm.py - vLLM client",
            "main.py - typer CLI",
            "memory.py - SQLite + distillation",
            "personality.py - system prompt",
            "streaming.py - sentence streaming",
            "stt.py - Whisper transcriber",
            "telegram_bot.py - bot bridge",
            "tools.py - sandboxed tools",
            "tts.py - Piper synthesis",
            "wake.py - openWakeWord detector",
            "watch.py - file watcher"
          ]
        }
      }
    },
    {
      "id": "VOXTRAL_COMPLETE.md",
      "label": "Voxtral Completion Report",
      "type": "documentation",
      "file_path": "VOXTRAL_COMPLETE.md",
      "language": "markdown",
      "description": "Final implementation report documenting the hybrid voice architecture decision: Voxtral for STT + CSM/Kokoro for TTS. Explains why unified approach was not used (Voxtral is STT-only), test results, performance gains, and complete installation guide.",
      "metadata": {
        "key_decision": "Voxtral is STT-only, not unified S2S model - hybrid approach is optimal",
        "architecture": {
          "stt": "Voxtral-Mini-4B-Realtime (<500ms latency)",
          "tts": "CSM 1B / Kokoro ONNX (retained from previous implementation)"
        },
        "performance_improvement": "1-2s faster vs faster-whisper",
        "latency_breakdown": {
          "before": "User speaks → VAD (700ms) → Whisper (1-3s) → LLM (2s) → TTS (1s) → Play = 4-7s",
          "after": "User speaks → VAD (700ms) → Voxtral (<500ms) → LLM (2s) → TTS (1s) → Play = 4-5s"
        },
        "test_results": [
          "Device detection (MPS on Apple Silicon)",
          "STT transcription (~1s synthetic audio)",
          "Audio resampling (8kHz to 48kHz)",
          "Performance benchmarks (0.84-1.13s per second)"
        ],
        "files_changed": {
          "created": [
            "jarvis/voice/stt.py (219 lines)",
            "tests/test_voice_stt_voxtral.py",
            "test_voxtral_stt_e2e.py",
            "docs/VOXTRAL_IMPLEMENTATION.md",
            "VOXTRAL_COMPLETE.md"
          ],
          "restored": ["jarvis/voice/tts.py (CSM/Kokoro)"],
          "modified": [
            "jarvis/main.py",
            "jarvis/core/config.py",
            "jarvis/voice/streaming.py",
            "pyproject.toml",
            "README.md"
          ],
          "removed": ["Old unified voxtral.py attempts"]
        },
        "configuration": {
          "stt": "HF_TOKEN, JARVIS_STT_LANGUAGE",
          "tts": "JARVIS_TTS_ENGINE (csm/kokoro), JARVIS_TTS_VOICE, JARVIS_TTS_SPEED"
        },
        "benchmarks_mps": {
          "model_loading": "3-5s (first run, then cached)",
          "transcription": "0.8-1.1s per second of audio",
          "expected_real_speech": "<500ms"
        }
      }
    },
    {
      "id": "VOXTRAL_IMPLEMENTATION.md",
      "label": "Voxtral Implementation Details",
      "type": "documentation",
      "file_path": "VOXTRAL_IMPLEMENTATION.md",
      "language": "markdown",
      "description": "Technical implementation summary of the Voxtral migration attempt. Documents the original plan for unified STT+TTS, VoxtralEngine class design, optimizations, testing strategy, and migration impact. Note: This documents the unified approach that was later changed to hybrid STT-only.",
      "metadata": {
        "original_plan": "Complete replacement with unified Voxtral-Mini-4B-Realtime for both STT and TTS",
        "architecture_comparison": {
          "before": "Audio → faster-whisper (STT) → Text; Text → CSM/Kokoro (TTS) → Audio",
          "planned_after": "Audio → Voxtral (STT) → Text; Text → Voxtral (TTS) → Audio",
          "future_vision": "Audio → Voxtral (Speech-to-Speech) → Audio (<200ms latency)"
        },
        "key_features": [
          "Unified 4B parameter model",
          "Apple Silicon MPS optimization with bf16 precision",
          "Phrase caching (~/.cache/jarvis/voxtral/*.npz)",
          "Streaming support via asyncio",
          "Hallucination filtering (low-energy rejection, repeated words)"
        ],
        "voxtral_engine_class": {
          "methods": [
            "transcribe(pcm16, sample_rate) - STT",
            "synthesize(text) - TTS",
            "prewarm(phrases) - cache common phrases"
          ],
          "optimizations": [
            "Lazy model loading",
            "Global model caching via @lru_cache",
            "Automatic resampling (16kHz → 24kHz native)",
            "Speed adjustment via torchaudio"
          ]
        },
        "simplified_config": {
          "kept": ["stt_language", "tts_speed", "tts_max_audio_ms"],
          "removed": [
            "stt_model",
            "stt_device",
            "stt_compute_type",
            "tts_engine",
            "tts_voice"
          ]
        },
        "performance_expectations": {
          "mps": {
            "model_loading": "3-5s (first run)",
            "stt_latency": "200-400ms",
            "tts_latency": "500ms-1s (warm)",
            "cached_phrases": "<10ms"
          },
          "cuda": {
            "model_loading": "2-4s",
            "stt_latency": "150-300ms",
            "tts_latency": "400-800ms"
          },
          "cpu": {
            "stt_latency": "2-5s",
            "tts_latency": "5-10s",
            "note": "Not recommended for real-time"
          }
        },
        "dependencies_changed": {
          "added": [
            "transformers>=4.48.0",
            "torch>=2.5.0",
            "torchaudio>=2.5.0",
            "accelerate>=0.34.0"
          ],
          "removed": [
            "faster-whisper>=1.0.3",
            "kokoro-onnx>=0.4.0"
          ]
        },
        "migration_impact": {
          "breaking": [
            "Old .env settings no longer used",
            "Kokoro model files obsolete",
            "Custom TTS/STT imports need updating"
          ],
          "non_breaking": [
            "Voice loop UX unchanged",
            "Phrase caching still works",
            "Streaming pipeline unchanged",
            "Audio I/O unchanged"
          ]
        },
        "rollback_plan": "git revert HEAD; pip install faster-whisper kokoro-onnx",
        "model_size": "~8GB (4B parameters in bf16)",
        "cache_locations": [
          "Model: ~/.cache/huggingface/hub/models--mistralai--Voxtral-Mini-4B-Realtime-2602/",
          "Phrases: ~/.cache/jarvis/voxtral/*.npz"
        ]
      }
    },
    {
      "id": "pyproject.toml",
      "label": "Python Project Configuration",
      "type": "config",
      "file_path": "pyproject.toml",
      "language": "toml",
      "description": "Python project metadata and dependency specification. Defines Jarvis as a proactive personal AI with LangGraph + mem0 + Claude API. Includes voice dependencies (Voxtral STT + CSM/Kokoro TTS), LLM orchestration, Google integrations, Telegram bot, and development tools.",
      "metadata": {
        "project_info": {
          "name": "jarvis",
          "version": "0.2.0",
          "description": "Proactive personal AI. LangGraph + mem0 + Claude API. Voice-first, Iron Man style.",
          "requires_python": ">=3.11",
          "license": "MIT"
        },
        "dependency_categories": {
          "llm_orchestration": ["langgraph>=0.2.0", "langchain-core>=0.3.0"],
          "memory": ["mem0ai>=0.1.0", "chromadb>=0.5.0"],
          "google_integrations": [
            "google-auth>=2.30.0",
            "google-auth-oauthlib>=1.2.0",
            "google-api-python-client>=2.130.0"
          ],
          "web_tools": ["trafilatura>=1.12.0", "duckduckgo-search>=6.0.0"],
          "voice": [
            "transformers>=4.48.0 (Voxtral STT)",
            "torch>=2.5.0 (with MPS support)",
            "torchaudio>=2.5.0",
            "mistral-common>=1.5.0",
            "kokoro-onnx>=0.4.0 (TTS fallback)",
            "sounddevice>=0.4.7",
            "soundfile>=0.12.0",
            "numpy>=1.26.0",
            "webrtcvad>=2.0.10",
            "accelerate>=0.34.0",
            "pynput>=1.7.6"
          ],
          "telegram_cli": [
            "python-telegram-bot>=21.4",
            "typer>=0.12.3",
            "rich>=13.7.1"
          ],
          "config": [
            "pydantic>=2.7.0",
            "pydantic-settings>=2.3.0",
            "python-dotenv>=1.0.1"
          ],
          "async_utils": [
            "anyio>=4.4.0",
            "watchfiles>=0.22.0",
            "httpx>=0.27.0"
          ]
        },
        "optional_dependencies": {
          "wake": ["openwakeword>=0.6.0"],
          "dev": ["pytest>=8.2.0", "pytest-asyncio>=0.23.7", "ruff>=0.5.0"]
        },
        "scripts": {
          "jarvis": "jarvis.main:app"
        },
        "build_system": {
          "requires": ["hatchling"],
          "build_backend": "hatchling.build"
        },
        "tooling": {
          "ruff": {
            "line_length": 100,
            "target_version": "py311",
            "select": ["E", "F", "I", "UP", "B", "SIM"],
            "ignore": ["E501"]
          },
          "pytest": {
            "asyncio_mode": "auto"
          }
        }
      }
    },
    {
      "id": "config_llm",
      "label": "LLM Configuration",
      "type": "component",
